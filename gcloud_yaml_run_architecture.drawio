                  <mxPoint x="510" y="190" />
                  <mxPoint x="350" y="190" />
                  <mxPoint x="350" y="440" />
              </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="edge_read_yaml" value="4. Read YAML &amp; Execute" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.25;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;" edge="1" parent="1" source="gcs_bucket" target="df_runtime">
          <mxGeometry relative="1" as="geometry" />
