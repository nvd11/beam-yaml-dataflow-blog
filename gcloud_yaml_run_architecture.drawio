<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="21.6.8">
  <diagram id="beam-yaml-quick-flow" name="Quick YAML Run Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Group 1: Local / CI -->
        <mxCell id="local_box" value="1. Developer / CI-CD&#10;(Local Workspace)" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="240" height="220" as="geometry" />
        </mxCell>
        <mxCell id="yaml_file" value="pipeline.yaml&#10;(Business Logic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1" vertex="1" parent="local_box">
          <mxGeometry x="40" y="60" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cli_cmd" value="gcloud dataflow yaml run&#10;(CLI Command)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="local_box">
          <mxGeometry x="20" y="150" width="200" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="edge_trigger" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="local_box" source="yaml_file" target="cli_cmd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Group 2: Google Managed Assets -->
        <mxCell id="google_box" value="Google Managed Infrastructure&#10;(Hidden from user)" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fillColor=#e1d5e7;fontColor=#333333;strokeColor=#9673a6;fontStyle=1;dashed=1" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="official_template" value="Official YAML Flex Template&#10;(Pre-configured JSON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="google_box">
          <mxGeometry x="50" y="50" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="official_image" value="Official Base Docker Image&#10;(Pre-installed Connectors)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="google_box">
          <mxGeometry x="60" y="100" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- Group 3: GCS -->
        <mxCell id="gcs_bucket" value="Cloud Storage (GCS)&#10;(Temporary Upload Location)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="420" y="240" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Group 4: Dataflow -->
        <mxCell id="df_runtime" value="GCP Dataflow Cluster&#10;(Serverless Execution)" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;width=220;height=140;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="370" y="400" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- Connections -->
        <mxCell id="edge_upload" value="1. Auto Upload YAML" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeWidth=2;strokeColor=#0000FF;fontColor=#0000FF;" edge="1" parent="1" source="cli_cmd" target="gcs_bucket">
          <mxGeometry relative="1" as="geometry">
              <Array as="points">
                  <mxPoint x="320" y="255" />
                  <mxPoint x="320" y="275" />
              </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="edge_invoke" value="2. Invoke Official Template&#10;with YAML path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#FF3333;fontColor=#FF3333;" edge="1" parent="1" source="cli_cmd" target="official_template">
          <mxGeometry relative="1" as="geometry">
              <Array as="points">
                  <mxPoint x="140" y="140" />
                  <mxPoint x="340" y="140" />
                  <mxPoint x="340" y="110" />
              </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="edge_pull_image" value="3. Pull Base Image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.1;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;" edge="1" parent="1" source="official_image" target="df_runtime">
          <mxGeometry relative="1" as="geometry">
